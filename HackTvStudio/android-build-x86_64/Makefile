####### Install

install_target: first FORCE
	@if not exist $(INSTALL_ROOT:@msyshack@%=%)\libs\x86_64 mkdir $(INSTALL_ROOT:@msyshack@%=%)\libs\x86_64 & if not exist $(INSTALL_ROOT:@msyshack@%=%)\libs\x86_64 exit 1
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT:@msyshack@%=%)\libs\x86_64\$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT:@msyshack@%=%)\libs\x86_64\$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT:@msyshack@%=%)\libs\x86_64 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

